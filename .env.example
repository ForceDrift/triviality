MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=triviality
REDIS_URL=redis://localhost:6379
OPENALEX_EMAIL=
OPENALEX_WORKS_FILTER=default.search:mathematics,type:article
OPENALEX_PER_PAGE=25
EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
ARTIFACT_ROOT=.data/object-storage
INGEST_INTERVAL_MINUTES=1440
RUN_ON_START=true
